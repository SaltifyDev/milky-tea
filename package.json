{
  "name": "@saltify/milky-tea",
  "type": "module",
  "version": "0.2.4",
  "packageManager": "pnpm@11.6.0",
  "description": "Client library for Milky Protocol.",
  "author": "SaltifyDev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SaltifyDev/milky-tea.git"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./event": {
      "types": "./dist/event.d.mts",
      "import": "./dist/event.mjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "generate-api": "sh ./scripts/fetch-types.sh",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:bundle": "pnpm run build && pnpm exec jiti ./scripts/check-build.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "fmt": "eslint . --fix",
    "prepare": "pnpm run generate-api",
    "bump": "bumpp"
  },
  "peerDependencies": {
    "zod": "^4.4.3"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.7.3",
    "@types/node": "^26.1.2",
    "@typescript/native-preview": "7.0.0-dev.20260309.1",
    "@vitest/coverage-v8": "^4.1.10",
    "bumpp": "^10.4.1",
    "change-case": "^5.4.4",
    "eslint": "^10.8.0",
    "jiti": "^2.7.0",
    "tsdown": "^0.21.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  }
}
